{{ structs }}

impl HasInference for OldResolvingLangType {
  fn recursive_inferred_types(&self) -> Vec<AnyOldResolvingLangType> {
    match self {
      {{#each langTypes}}
        OldResolvingLangType::{{name}}{{#if hasParam}}(it) => {{inferenceGetRecursiveInferredTypesExpression}}{{else}} => vec![]{{/if}},
      {{/each}}
    }
  }

  fn fill_variable(&self, id: u64, value: AnyOldResolvingLangType) -> Self {
    match self {
      {{#each langTypes}}
        OldResolvingLangType::{{name}}{{#if hasParam}}(it) => OldResolvingLangType::{{name}}({{inferenceFillVariableExpression}}){{else}} => OldResolvingLangType::{{name}}{{/if}},
      {{/each}}
    }
  }
}

{{#each complexLangTypes}}
impl HasInference for {{structName}} {
  fn recursive_inferred_types(&self) -> Vec<AnyOldResolvingLangType> {
    let mut result = vec![];
    {{#each fields}}
    {{#if hasSubtypes}}
    result.append(&mut {{inferenceGetRecursiveInferredTypesExpression}});
    {{/if}}
    {{/each}}
    return result;
  }
  fn fill_variable(&self, id: u64, value: AnyOldResolvingLangType) -> Self {
    return Self {
      {{#each fields}}
        {{name}}: {{inferenceFillVariableExpression}},
      {{/each}}
    }
  }
}
{{/each}}